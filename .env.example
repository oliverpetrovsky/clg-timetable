# ==========================================
# COLLEGE TIMETABLE TRACKER - ENV CONFIG
# ==========================================

# 🍃 MongoDB Connection URI (MongoDB Atlas or self-hosted MongoDB)
# Example: mongodb+srv://username:password@cluster.mongodb.net/timetable?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/college-timetable?retryWrites=true&w=majority

# 🔐 JWT Secret for signing session tokens (use `openssl rand -hex 32` or let Render auto-generate)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# 🏫 Allowed College Email Domain (* allows all emails, or e.g. 'college.edu')
ALLOWED_EMAIL_DOMAIN=*

# 🏷️ Public Application Name
NEXT_PUBLIC_APP_NAME=College Timetable Tracker
