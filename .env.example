# ==========================================
# TimeTrack - Production Environment Variables
# ==========================================

# 1. MongoDB Connection String (MongoDB Atlas or Azure Cosmos DB for MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/college-timetable?retryWrites=true&w=majority

# 2. JWT Secret Key (Generate a random 32+ character key: `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_production_jwt_key_here_at_least_32_chars

# 3. Allowed Domain for Registration (e.g. iiitb.ac.in or your institution domain)
ALLOWED_EMAIL_DOMAIN=iiitb.ac.in

# 4. Node Environment
NODE_ENV=production
PORT=3000

# 5. Optional Initial Seed Admin Password (Used when running `npm run seed`)
# SEED_ADMIN_PASSWORD=your_secure_admin_password
# SEED_STUDENT_PASSWORD=your_secure_student_password
# SEED_BRANCH_PASSWORD=your_secure_branch_password
