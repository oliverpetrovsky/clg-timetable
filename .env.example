# ==========================================
# TimeTrack - Production Environment Variables
# ==========================================

# 1. MongoDB Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/college-timetable?retryWrites=true&w=majority

# 2. JWT Secret Key (Generate a random 32+ character key: `openssl rand -base64 32`)
JWT_SECRET=your_super_secret_production_jwt_key_here_at_least_32_chars

# 3. Allowed Domain for Registration
ALLOWED_EMAIL_DOMAIN=iiitb.ac.in

# 4. Node Environment & Server Port
NODE_ENV=production
PORT=3000

# 5. Super Admin Account (Created using environment variables on Render)
SUPER_ADMIN_EMAIL=classreps@iiitb.ac.in
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password
